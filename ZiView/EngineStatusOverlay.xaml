<Window x:Class="ZiView.EngineStatusOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZiView" Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Background="#1E1E1E" BorderBrush="#555555" BorderThickness="1"
            CornerRadius="8" Padding="24">
        <StackPanel>
            <ProgressBar x:Name="Spinner" IsIndeterminate="True" Height="4"
                         Foreground="#0078D4" Background="#3A3A3A" BorderThickness="0"/>
            <TextBlock x:Name="TbMessage" Margin="0,16,0,0"
                       Foreground="White" FontSize="13"
                       FontFamily="Segoe UI, Yu Gothic UI"
                       TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
