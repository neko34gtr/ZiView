<UserControl x:Class="ZiView.ReadingModeSegmentedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Height="36" HorizontalAlignment="Stretch" Margin="0,0,0,14" Focusable="False">
    <!--        モックアップ（ボタンのイメージ.html）のpill-button + segment構成をそのままWPFへ移植。        外枠カプセル: 角丸24, 枠線2px #555, 背景#3b3b3b。内部3区画は境界線1px #555区切りで、        両端のみ内側角丸22（外枠2pxぶん差し引いた値）。選択中区画は青系ハイライト、非選択はホバーのみ反応。    -->
    <Border BorderBrush="#FF555555" BorderThickness="2" CornerRadius="18" Background="#FF3B3B3B" ClipToBounds="True">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="SegL2" Grid.Column="0" CornerRadius="16,0,0,16"
                    Background="#FF3B3B3B" BorderBrush="#FF555555" BorderThickness="0,0,1,0"
                    Cursor="Hand" Tag="LeftOpen"
                    MouseLeftButtonUp="Segment_MouseLeftButtonUp"
                    MouseEnter="Segment_MouseEnter" MouseLeave="Segment_MouseLeave"
                    ToolTip="左開き（洋書方式）: 現在ページを左、次ページを右に配置">
                <TextBlock x:Name="TextL2" Text="L2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="14" Foreground="#FFDDDDDD"/>
            </Border>

            <Border x:Name="SegS1" Grid.Column="1"
                    Background="#FF3B3B3B" BorderBrush="#FF555555" BorderThickness="0,0,1,0"
                    Cursor="Hand" Tag="Single"
                    MouseLeftButtonUp="Segment_MouseLeftButtonUp"
                    MouseEnter="Segment_MouseEnter" MouseLeave="Segment_MouseLeave"
                    ToolTip="単ページ表示（見開きなし）">
                <TextBlock x:Name="TextS1" Text="S1" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="14" Foreground="#FFDDDDDD"/>
            </Border>

            <Border x:Name="SegR2" Grid.Column="2" CornerRadius="0,16,16,0"
                    Background="#FF3B3B3B"
                    Cursor="Hand" Tag="RightOpen"
                    MouseLeftButtonUp="Segment_MouseLeftButtonUp"
                    MouseEnter="Segment_MouseEnter" MouseLeave="Segment_MouseLeave"
                    ToolTip="右開き（従来のマンガ方式）: 現在ページを右、次ページを左に配置">
                <TextBlock x:Name="TextR2" Text="R2" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="14" Foreground="#FFDDDDDD"/>
            </Border>
        </Grid>
    </Border>
</UserControl>